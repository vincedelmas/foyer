# Required for TMDB matching and metadata. Create a read access token at tmdb.org.
TMDB_READ_ACCESS_TOKEN=

# Media and database paths are resolved on the host, never inside a browser.
PLOUX_DATABASE_PATH=./data/ploux.sqlite

# Optional. Defaults to * so a sideloaded TV client can reach the API on your LAN.
PLOUX_CORS_ORIGIN=*

# Optional public server URL used in logs/documentation, e.g. http://192.168.1.10:3000.
PLOUX_PUBLIC_URL=http://localhost:3000
