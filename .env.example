# Optional. Enables TMDB matching and metadata. Create a read access token at tmdb.org.
TMDB_READ_ACCESS_TOKEN=

# Media and database paths are resolved on the host, never inside a browser.
FOYER_DATABASE_PATH=./data/foyer.sqlite

# Optional. Android TV caches lossless AVI-to-MKV compatibility remuxes here.
FOYER_CACHE_PATH=./data/cache

# Optional. Allow one separate browser origin, for example http://192.168.1.10:5173.
# The web app is same-origin and Android TV does not require browser CORS headers.
FOYER_CORS_ORIGIN=
