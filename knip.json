{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/routes/**/*.{ts,tsx}",
                "server.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ]
        }
    },
    "ignore": [
        "src/components/ui/**"
    ],
    "ignoreDependencies": [
        "@fontsource-variable/manrope",
        "@tanstack/router-plugin",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
    ]
}
