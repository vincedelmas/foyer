{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/routes/**/*.{ts,tsx}",
                "server.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ]
        },
        "apps/tv": {
            "entry": [
                "App.tsx",
                "plugins/with-tv-runtime.cjs",
                "plugins/with-release-signing.cjs"
            ],
            "project": [
                "**/*.{ts,tsx,cjs}"
            ],
            "ignoreDependencies": [
                "expo-updates"
            ]
        }
    },
    "ignore": [
        "src/components/ui/**"
    ],
    "ignoreDependencies": [
        "@fontsource-variable/manrope",
        "@tanstack/router-plugin",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
    ]
}
