{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/router.tsx",
                "src/start.ts",
                "src/routes/**/*.{ts,tsx}",
                "vite.config.ts",
                "drizzle.config.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ]
        },
        "apps/tv": {
            "entry": [
                "index.ts",
                "App.tsx",
                "plugins/with-release-signing.cjs"
            ],
            "project": [
                "**/*.{ts,tsx,cjs}"
            ],
            "ignoreDependencies": [
                "expo-updates",
                "expo-system-ui"
            ]
        },
        "packages/contracts": {
            "entry": [
                "src/index.ts"
            ]
        }
    },
    "ignore": [
        "src/components/ui/**",
        "src/routeTree.gen.ts",
        "drizzle/**"
    ],
    "ignoreDependencies": [
        "@fontsource-variable/manrope",
        "@tanstack/router-plugin",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
    ]
}
