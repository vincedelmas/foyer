{
    "name": "@ploux/web",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "knip": "knip",
        "test": "vitest run",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "tv": "bun --cwd apps/tv start",
        "db:studio": "drizzle-kit studio",
        "db:migrate": "drizzle-kit migrate",
        "db:generate": "drizzle-kit generate",
        "start": "bun .output/server/index.mjs",
        "dev": "bun --bun vite dev --port 3000",
        "tv:android": "bun --cwd apps/tv android",
        "lint": "oxlint --type-aware --type-check",
        "preview": "bun run build && bun run start",
        "lint:fix": "oxlint --type-aware --type-check --fix",
        "typecheck:tv": "tsc --noEmit -p apps/tv/tsconfig.json",
        "verify": "bun run typecheck && bun run typecheck:tv && bun run lint && bun run knip && bun run test && bun run build"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@ploux/contracts": "workspace:*",
        "@tailwindcss/vite": "^4",
        "@tanstack/react-devtools": "latest",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@tanstack/react-router": "latest",
        "@tanstack/react-router-devtools": "latest",
        "@tanstack/react-start": "latest",
        "@tanstack/react-store": "^0.11.1",
        "@tanstack/react-table": "^9.2.3",
        "@tanstack/router-plugin": "latest",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^1.34.0",
        "nitro": "npm:nitro-nightly@^3.0.1-20260826-135133-65a4e394",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tanstack/devtools-vite": "latest",
        "@types/bun": "^1.4.0",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6",
        "drizzle-kit": "^0.31.10",
        "jsdom": "^28",
        "knip": "^6.32.3",
        "oxc-transform-react": "^0.147.0",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6",
        "vite": "^8",
        "vitest": "^4"
    }
}
