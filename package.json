{
    "name": "@foyer/web",
    "version": "1.4.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.0",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "knip": "knip",
        "test": "vitest run",
        "build:server": "bun --bun vite build",
        "build:entry": "bun build ./server.ts --target=bun --outfile=./dist/server.js",
        "build": "bun run build:server && bun run build:entry",
        "typecheck": "tsc --noEmit",
        "db:studio": "drizzle-kit studio",
        "db:migrate": "drizzle-kit migrate",
        "db:generate": "drizzle-kit generate",
        "start": "bun dist/server.js",
        "dev": "bun --bun vite dev --port 3000",
        "lint": "oxlint --type-aware --type-check",
        "preview": "bun run build && bun run start",
        "lint:fix": "oxlint --type-aware --type-check --fix",
        "verify": "bun run typecheck && bun run lint && bun run knip && bun run test && bun run build"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@foyer/contracts": "workspace:*",
        "@foyer/query": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@tanstack/react-router": "latest",
        "@tanstack/react-start": "latest",
        "@tanstack/react-store": "^0.11.2",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/router-plugin": "latest",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shadcn": "^4.22.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@libsql/client": "^0.17.4",
        "@types/bun": "^1.4.4",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "drizzle-kit": "^0.31.11",
        "jsdom": "^28.1.0",
        "knip": "^6.43.0",
        "oxc-transform-react": "^0.147.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
